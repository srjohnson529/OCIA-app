<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Illumined" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">serif</item>
        <item name="android:windowSplashScreenBackground">@color/illumined_blue</item>
        <!-- Keep Android's required handoff splash icon invisible.  The full
             Illumined brand is rendered immediately afterward by Compose. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/illumined_splash_placeholder</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/illumined_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#120F1A</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
