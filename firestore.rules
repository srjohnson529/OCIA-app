rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function isInstructor() {
      return signedIn() &&
        exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
        userProfile().isInstructor == true;
    }

    function isOwnDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isInClass(classId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
        classId in userProfile().classIds;
    }

    function canReadClass(classId) {
      return isInClass(classId) || isInstructor();
    }

    function canTeachClass(classId) {
      return isInstructor() && isInClass(classId);
    }

    match /userProfiles/{userId} {
      allow create: if isOwnDocument(userId);
      allow read: if isOwnDocument(userId) || isInstructor();
      allow update: if isOwnDocument(userId) || isInstructor();
      allow delete: if isInstructor();
    }

    match /chatMessages/{messageId} {
      allow read: if signedIn() && canReadClass(resource.data.classId);
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        isInClass(request.resource.data.classId);
      allow update, delete: if signedIn() &&
        (resource.data.senderId == request.auth.uid || isInstructor());
    }

    match /prayerRequests/{requestId} {
      allow read: if signedIn() && canReadClass(resource.data.classId);

      allow create: if signedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        isInClass(request.resource.data.classId) &&
        request.resource.data.title is string &&
        request.resource.data.details is string &&
        request.resource.data.expiresAt > request.time;

      allow update: if signedIn() &&
        (resource.data.requesterId == request.auth.uid || isInstructor());

      allow delete: if signedIn() &&
        (
          resource.data.requesterId == request.auth.uid ||
          isInstructor() ||
          (canReadClass(resource.data.classId) && resource.data.expiresAt <= request.time)
        );
    }

    match /announcements/{announcementId} {
      allow read: if signedIn() &&
        (isInstructor() || resource.data.classId in userProfile().classIds);
      allow create, update, delete: if isInstructor();
    }

    match /classSchedule/{scheduleId} {
      allow read: if signedIn() &&
        (isInstructor() || resource.data.classId in userProfile().classIds);
      allow create, update, delete: if isInstructor();
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn() &&
        (isInstructor() || resource.data.classId in userProfile().classIds);
      allow create, update, delete: if isInstructor();
    }

    match /assignmentCompletions/{completionId} {
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isInstructor()
        );

      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isInClass(request.resource.data.classId);

      allow delete: if signedIn() &&
        (resource.data.userId == request.auth.uid || isInstructor());
    }

    match /discussionPrompts/{promptId} {
      allow read: if signedIn() &&
        (
          isInstructor() ||
          (
            resource.data.isActive == true &&
            resource.data.classId in userProfile().classIds
          )
        );

      allow create, update, delete: if isInstructor();
    }

    match /discussionPosts/{postId} {
      allow read: if signedIn() && canReadClass(resource.data.classId);

      allow create: if signedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        isInClass(request.resource.data.classId) &&
        request.resource.data.promptId is string &&
        request.resource.data.lessonId is string &&
        request.resource.data.message is string;

      allow update, delete: if signedIn() &&
        (resource.data.authorId == request.auth.uid || isInstructor());
    }

    match /discussionReplies/{replyId} {
      allow read: if signedIn() && canReadClass(resource.data.classId);

      allow create: if signedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        isInClass(request.resource.data.classId) &&
        request.resource.data.postId is string &&
        request.resource.data.promptId is string &&
        request.resource.data.lessonId is string &&
        request.resource.data.message is string;

      allow update, delete: if signedIn() &&
        (resource.data.authorId == request.auth.uid || isInstructor());
    }

    match /discussionParticipation/{participationId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isInstructor());

      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isInClass(request.resource.data.classId);

      allow delete: if signedIn() &&
        (resource.data.userId == request.auth.uid || isInstructor());
    }

    match /classrooms/{classId} {
      allow read: if signedIn() && (canReadClass(classId) || resource.data.instructorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.instructorId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.instructorId == request.auth.uid || isInstructor());
    }

    match /classrooms/{classId}/lessonOverrides/{lessonId} {
      allow read: if isInClass(classId);
      allow create, update, delete: if canTeachClass(classId);
    }

    match /classrooms/{classId}/customLessons/{lessonId} {
      allow read: if isInClass(classId) && resource.data.isPublished != false;
      allow read: if canTeachClass(classId);
      allow create, update, delete: if canTeachClass(classId);
    }

    match /classrooms/{classId}/settings/{settingId} {
      allow read: if isInClass(classId);
      allow create, update, delete: if canTeachClass(classId);
    }


    // Rite preparations are class-scoped. A receipt is not sacramental attendance.
    function riteMember(classId) {
      return isInClass(classId) &&
        (!exists(/databases/$(database)/documents/classrooms/$(classId)) ||
         get(/databases/$(database)/documents/classrooms/$(classId)).data.get('isArchived', false) == false);
    }
    function riteTeacher(classId) { return isInstructor() && riteMember(classId); }
    function validRite() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title','meaning','context','studentActions','ministerActions','preparation',
        'riteDate','timeZone','expiresAt','published','revision','createdBy','updatedBy','updatedAt',
        'meaningHeading','contextHeading','studentActionsHeading','ministerActionsHeading','preparationHeading','deleted']) &&
        (!('deleted' in d) || (d.deleted is bool && (!d.deleted || d.published == false))) &&
        (!('meaningHeading' in d) || (d.meaningHeading is string && d.meaningHeading.size() > 0 && d.meaningHeading.size() <= 160)) &&
        (!('contextHeading' in d) || (d.contextHeading is string && d.contextHeading.size() > 0 && d.contextHeading.size() <= 160)) &&
        (!('studentActionsHeading' in d) || (d.studentActionsHeading is string && d.studentActionsHeading.size() > 0 && d.studentActionsHeading.size() <= 160)) &&
        (!('ministerActionsHeading' in d) || (d.ministerActionsHeading is string && d.ministerActionsHeading.size() > 0 && d.ministerActionsHeading.size() <= 160)) &&
        (!('preparationHeading' in d) || (d.preparationHeading is string && d.preparationHeading.size() > 0 && d.preparationHeading.size() <= 160)) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 160 &&
        d.meaning is string && d.meaning.size() > 0 && d.meaning.size() <= 12000 &&
        d.context is string && d.context.size() > 0 && d.context.size() <= 12000 &&
        d.studentActions is string && d.studentActions.size() > 0 && d.studentActions.size() <= 12000 &&
        d.ministerActions is string && d.ministerActions.size() > 0 && d.ministerActions.size() <= 12000 &&
        d.preparation is string && d.preparation.size() > 0 && d.preparation.size() <= 12000 &&
        d.riteDate is string && d.riteDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        d.timeZone is string && d.timeZone.size() > 0 && d.timeZone.size() <= 100 &&
        d.expiresAt is timestamp && d.published is bool &&
        (!d.published || d.expiresAt > request.time) &&
        d.revision is string && d.revision.size() > 0 && d.revision.size() <= 100 &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    match /classrooms/{classId}/ritePreparations/{riteId} {
      allow read: if riteTeacher(classId) || (riteMember(classId) && resource.data.published == true);
      allow create: if riteTeacher(classId) && validRite() && request.resource.data.createdBy == request.auth.uid;
      allow update: if riteTeacher(classId) && validRite() &&
        resource.data.get('deleted', false) == false &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.revision != resource.data.revision;
      allow delete: if false; // Unpublish instead; preserve acknowledgment records.
      match /acknowledgments/{userId} {
        allow get: if riteTeacher(classId) || (riteMember(classId) && isOwnDocument(userId));
        allow list: if riteTeacher(classId);
        allow create, update: if riteMember(classId) && isOwnDocument(userId) &&
          request.resource.data.keys().hasOnly(['userId','revision','acknowledgedAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.acknowledgedAt == request.time &&
          get(/databases/$(database)/documents/classrooms/$(classId)/ritePreparations/$(riteId)).data.published == true &&
          get(/databases/$(database)/documents/classrooms/$(classId)/ritePreparations/$(riteId)).data.expiresAt > request.time &&
          request.resource.data.revision ==
            get(/databases/$(database)/documents/classrooms/$(classId)/ritePreparations/$(riteId)).data.revision;
        allow delete: if false;
      }
    }

    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
