{
  "hosting": {
    "appAssociation": "NONE",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {"source": "/join", "destination": "/join.html"},
      {"source": "/.well-known/assetlinks.json", "destination": "/android-app-links.json"},
      {"source": "/.well-known/apple-app-site-association", "destination": "/apple-app-links.json"},
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/account-deletion",
        "destination": "/account-deletion.html"
      },
      {
        "source": "**",
        "destination": "/Catechism app.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "ocia_functions_code",
    "codebase": "ocia_functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint"
    ]
  }
}
